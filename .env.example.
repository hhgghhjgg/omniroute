# ============================================================
# OmniRoute - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# On Render, add these in the "Environment Variables" section.
# ============================================================

# ------------------------------------------------------------
# SERVER CONFIGURATION
# ------------------------------------------------------------
# Port OmniRoute listens on
PORT=20128

# Host to bind to (keep 0.0.0.0 for Render)
HOST=0.0.0.0

# Data directory for OmniRoute state
OMNIROUTE_DATA_DIR=/app/data

# Database path (SQLite)
OMNIROUTE_DB_PATH=/app/data/omniroute.db

# Config file path
OMNIROUTE_CONFIG_PATH=/app/data/config.json

# Node.js memory limit (important for Render Free tier - 512MB)
# 384MB leaves room for OS and other processes
NODE_OPTIONS=--max-old-space-size=384

# Disable telemetry/analytics
OMNIROUTE_TELEMETRY=0
OMNIROUTE_ANALYTICS=0

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------
# API Key to protect OmniRoute dashboard and API
# If not set, anyone with your URL can access everything
# Generate one: openssl rand -hex 32
OMNIROUTE_API_KEY=your-secret-api-key-here

# CORS allowed origins (comma-separated)
# Set to your Hermes service URL for security
OMNIROUTE_CORS_ORIGINS=https://your-hermes-app.onrender.com

# Rate limiting (requests per minute)
OMNIROUTE_RATE_LIMIT=100

# ------------------------------------------------------------
# PROVIDER API KEYS (OPTIONAL)
# ------------------------------------------------------------
# You can set these here or add them through the dashboard.
# Setting them here makes them persist across restarts.
# Only set the ones you actually use.

# --- Free Tier Providers (Recommended) ---

# DeepSeek - https://platform.deepseek.com (free tier available)
# Models: deepseek-chat, deepseek-reasoner
DEEPSEEK_API_KEY=

# Google Gemini - https://aistudio.google.com/apikey (free tier)
# Models: gemini-2.5-flash, gemini-2.5-pro
GOOGLE_API_KEY=
GEMINI_API_KEY=

# SiliconFlow - https://siliconflow.cn (free tier, no card needed)
# Models: DeepSeek-V3.2, DeepSeek-R1
SILICONFLOW_API_KEY=

# Groq - https://console.groq.com (free tier, very fast)
# Models: llama-3.3-70b, mixtral-8x7b
GROQ_API_KEY=

# OpenRouter - https://openrouter.ai (free models available)
# Models: :free variants of many models
OPENROUTER_API_KEY=

# Z.AI GLM - https://z.ai (free tier)
# Models: glm-4.7, glm-4.5-flash
ZAI_API_KEY=

# Cerebras - https://cerebras.ai (free tier, 1M tokens/day)
# Models: glm-4.7, gpt-oss
CEREBRAS_API_KEY=

# Together AI - https://together.ai (free tier)
# Models: Llama, Mixtral, DeepSeek
TOGETHER_API_KEY=

# Fireworks AI - https://fireworks.ai (free tier)
# Models: Llama, Mixtral
FIREWORKS_API_KEY=

# NVIDIA NIM - https://build.nvidia.com (free tier, ~40 RPM)
# Models: GLM, MiniMax
NVIDIA_API_KEY=

# Hugging Face - https://huggingface.co (free tier)
# Models: Many open-source models
HUGGINGFACE_API_KEY=

# Mistral AI - https://mistral.ai (free tier)
# Models: mistral-small, mistral-medium
MISTRAL_API_KEY=

# Cohere - https://cohere.com (free tier)
# Models: command-r, command-r-plus
COHERE_API_KEY=

# --- Paid/Subscription Providers (Optional) ---

# OpenAI - https://platform.openai.com
OPENAI_API_KEY=

# Anthropic - https://console.anthropic.com
ANTHROPIC_API_KEY=

# xAI Grok - https://x.ai
XAI_API_KEY=

# Perplexity - https://perplexity.ai
PERPLEXITY_API_KEY=

# MiniMax - https://minimax.io
MINIMAX_API_KEY=

# Baidu ERNIE - https://cloud.baidu.com
BAIDU_API_KEY=

# ------------------------------------------------------------
# OAUTH/SESSION PROVIDERS (OPTIONAL)
# ------------------------------------------------------------
# These are typically configured through the dashboard.
# Setting them here provides persistence across restarts.

# Qwen OAuth (from Qwen CLI auth)
QWEN_ACCESS_TOKEN=
QWEN_REFRESH_TOKEN=
QWEN_RESOURCE_URL=portal.qwen.ai

# Kiro AI (Claude access via OAuth)
# Get this from the dashboard OAuth flow
KIRO_SESSION_TOKEN=

# Cursor (via session cookie)
CURSOR_SESSION_COOKIE=

# GitHub Copilot (via OAuth)
COPILOT_OAUTH_TOKEN=

# ------------------------------------------------------------
# COMPRESSION SETTINGS (OPTIONAL)
# ------------------------------------------------------------
# Token compression saves 15-95% of tokens
# Modes: off, lite, standard, aggressive, ultra, rtk, stacked

# Default compression mode
OMNIROUTE_COMPRESSION_MODE=stacked

# Enable/disable specific compression engines
OMNIROUTE_COMPRESSION_RTK=1
OMNIROUTE_COMPRESSION_CAVEMAN=1
OMNIROUTE_COMPRESSION_LLMLINGUA=0

# ------------------------------------------------------------
# ROUTING SETTINGS (OPTIONAL)
# ------------------------------------------------------------
# Default routing strategy
# Options: auto, priority, round-robin, cost-optimized, least-used
OMNIROUTE_DEFAULT_STRATEGY=auto

# Auto-combo settings
OMNIROUTE_AUTO_COMBO=1
OMNIROUTE_FALLBACK_ENABLED=1
OMNIROUTE_MAX_FALLBACK_ATTEMPTS=3

# ------------------------------------------------------------
# LOGGING & DEBUGGING (OPTIONAL)
# ------------------------------------------------------------
# Log level: error, warn, info, debug, trace
OMNIROUTE_LOG_LEVEL=info

# Enable request logging
OMNIROUTE_LOG_REQUESTS=0

# Log file path (if empty, logs to stdout)
OMNIROUTE_LOG_FILE=

# ------------------------------------------------------------
# ADVANCED SETTINGS (OPTIONAL)
# ------------------------------------------------------------
# Request timeout in seconds
OMNIROUTE_REQUEST_TIMEOUT=300

# Max concurrent requests
OMNIROUTE_MAX_CONCURRENT=10

# Enable/disable specific features
OMNIROUTE_ENABLE_MCP=1
OMNIROUTE_ENABLE_A2A=1
OMNIROUTE_ENABLE_MEMORY=0

# Circuit breaker settings
OMNIROUTE_CIRCUIT_BREAKER_THRESHOLD=5
OMNIROUTE_CIRCUIT_BREAKER_RESET=60

# Key cooldown in seconds
OMNIROUTE_KEY_COOLDOWN=5

# ============================================================
# END OF TEMPLATE
# ============================================================
